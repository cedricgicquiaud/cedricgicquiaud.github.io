{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedricgicquiaud.github.io/proofs.schema.json",
  "title": "Preuves de Cédric Gicquiaud",
  "type": "object",
  "properties": {
    "fiches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "nom", "url", "periode", "role", "stack", "visibilite", "depot", "demo", "enBref", "chiffres", "captures", "sections"],
        "properties": {
          "slug": { "type": "string" },
          "nom": { "type": "string" },
          "url": { "type": "string" },
          "periode": { "type": "string" },
          "role": { "type": "string" },
          "stack": { "type": "array", "items": { "type": "string" } },
          "visibilite": { "enum": ["public", "vitrine", "anonyme", "prive"] },
          "depot": { "type": "string" },
          "demo": { "type": "string" },
          "enBref": { "type": "string" },
          "chiffres": { "type": "array" },
          "captures": { "type": "array" },
          "sections": { "type": "array" }
        }
      }
    }
  }
}
