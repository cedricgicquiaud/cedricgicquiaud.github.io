{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedricgicquiaud.github.io/proofs.schema.json",
  "title": "Preuves de Cédric Gicquiaud",
  "type": "object",
  "properties": {
    "fiches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" }
        }
      }
    }
  }
}
